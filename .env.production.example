# File này dành cho docker-compose production trên Hetzner.
# Copy thành `.env` ở server: cp .env.production.example .env

# Domain — Caddy dùng để xin SSL Let's Encrypt tự động
DOMAIN=mathverse.example.com

# Postgres trong docker-compose
POSTGRES_USER=mathverse
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=mathverse

# MinIO (S3-compatible storage)
# Đặt access key + secret key mạnh, random
MINIO_ROOT_USER=mathverse
MINIO_ROOT_PASSWORD=change-me-strong-random-min-12-chars

# S3 client config — dùng để app gọi MinIO
# S3_ENDPOINT là URL nội bộ docker network (app → minio)
# S3_PUBLIC_ENDPOINT là URL browser dùng để tải file (qua Caddy → minio)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://mathverse.example.com/storage
S3_REGION=us-east-1
S3_ACCESS_KEY=mathverse
S3_SECRET_KEY=change-me-strong-random-min-12-chars

# Admin seed account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
